# Copy to .env and fill in.  .env is gitignored -- never commit it.

# ---------------------------------------------------------------- search
# SerpApi powers both the Google Lens and Yandex providers.
# Free tier ~100 searches/month: https://serpapi.com/
SERPAPI_KEY=

# ---------------------------------------------------------------- chain
# USE A THROWAWAY WALLET. Testnet funds only. Never a key that holds value.
# 64 hex chars, with or without the 0x prefix.
PRIVATE_KEY=

# Base Sepolia is the default public testnet. The public RPC below works, but a
# dedicated endpoint (Alchemy / QuickNode) is more reliable during a live demo.
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Optional second testnet
SEPOLIA_RPC=

# Local Anvil / Hardhat node
LOCAL_RPC=http://127.0.0.1:8545

# Which chain the CLI targets when --chain is omitted
DEFAULT_CHAIN=local

# ---------------------------------------------------------------- tuning
# ArcFace cosine cutoff for "same person". 0.40 is conservative.
FACE_MATCH_THRESHOLD=0.40

# Perceptual-match tolerances used by the PERCEPTUAL verdict
PHASH_HAMMING_MAX=8
PERCEPTUAL_COSINE_MIN=0.90

# How much context to include around the face when searching (0.6 = 60% margin)
CROP_MARGIN=0.60

SEARCH_LIMIT=25
HTTP_TIMEOUT=30

# Set to 0 to watch the Playwright provider drive a visible browser
PLAYWRIGHT_HEADLESS=1
