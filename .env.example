# Copy to .env and fill in.  .env is gitignored -- never commit it.

# ---------------------------------------------------------------- search
# SerpApi powers both the Google Lens and Yandex providers.
# Free tier ~100 searches/month: https://serpapi.com/
SERPAPI_KEY=

# ---------------------------------------------------------------- chain
# USE A THROWAWAY WALLET. Testnet funds only. Never a key that holds value.
# 64 hex chars, with or without the 0x prefix.
#
# Keys resolve per network, most specific first:
#   1. PRIVATE_KEY_<NETWORK>   e.g. PRIVATE_KEY_BASE_SEPOLIA
#   2. PRIVATE_KEY             shared fallback
#   3. the Hardhat dev account -- LOCAL CHAIN ONLY, applied automatically
#
# So you can leave PRIVATE_KEY empty, let --chain local use the free pre-funded
# Hardhat account, and give the public testnet its own funded throwaway wallet.
# Signing on a public network with the Hardhat dev key is refused outright: it
# is public knowledge, so the on-chain `submitter` would prove nothing.
PRIVATE_KEY=

# Funded throwaway wallet for a public testnet. Generate one with:
#   python -c "from eth_account import Account; a=Account.create(); print(a.address); print(a.key.hex())"
# then fund the ADDRESS (never paste the key anywhere) at a faucet.
#
# A balance is PER CHAIN. The same address exists on every EVM network, but funding
# Ethereum Sepolia does nothing for Base Sepolia. Fund the chain you intend to use.
# The same key can fill both variables below.
#
# Ethereum Sepolia faucet -- Google account only, no mainnet balance required:
#   https://cloud.google.com/application/web3/faucet/ethereum/sepolia
PRIVATE_KEY_SEPOLIA=

# Base Sepolia faucet -- free CDP signup. The Alchemy/QuickNode Base faucets
# require you to already hold mainnet ETH.
#   https://portal.cdp.coinbase.com/products/faucet
PRIVATE_KEY_BASE_SEPOLIA=

# Base Sepolia: 2 s blocks, BaseScan explorer. The public RPC below works, but a
# dedicated endpoint (Alchemy / QuickNode) is more reliable during a live demo.
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Ethereum Sepolia: 12 s blocks, Etherscan explorer, easiest faucet.
# This free public RPC needs no signup.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Local Anvil / Hardhat node
LOCAL_RPC=http://127.0.0.1:8545

# Which chain the CLI targets when --chain is omitted
DEFAULT_CHAIN=local

# ---------------------------------------------------------------- tuning
# ArcFace cosine cutoff for "same person". 0.40 is conservative.
FACE_MATCH_THRESHOLD=0.40

# Perceptual-match tolerances used by the PERCEPTUAL verdict
PHASH_HAMMING_MAX=8
PERCEPTUAL_COSINE_MIN=0.90

# How much context to include around the face when searching (0.6 = 60% margin)
CROP_MARGIN=0.60

SEARCH_LIMIT=25
HTTP_TIMEOUT=30

# Set to 0 to watch the Playwright provider drive a visible browser
PLAYWRIGHT_HEADLESS=1
